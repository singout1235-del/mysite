+    .filter(m => !q || m.id.toLowerCase().includes(q));
+  if (!chatModels.length) {
+    list.innerHTML = `<p class="dim center">No models${q ? " match" : " loaded — connect first"}.</p>`;
+  } else {
+    list.innerHTML = chatModels.map(m =>
